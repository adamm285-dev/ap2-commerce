# ==============================================================================
# AP2 Autonomous Commerce & PayPal Agentic Commerce — Environment Configuration
# ==============================================================================
# NOTE: This file contains sample configuration. Copy this file to .env and
# populate values. NEVER commit .env to public version control.

# ------------------------------------------------------------------------------
# Frontend Application (Vite / React)
# ------------------------------------------------------------------------------
# AG Studio v3.0.0 License Key (https://www.ag-grid.com/studio/react/licence-install/)
# Leave blank to run in developer evaluation mode (includes watermark)
VITE_AG_STUDIO_LICENSE_KEY=

# PayPal Developer Sandbox Client Credentials (https://developer.paypal.com/dashboard/)
# 'test' enables sandbox SDK buttons without live client verification
VITE_PAYPAL_CLIENT_ID=test
VITE_PAYPAL_PLAN_ID=P-AP2-BATCH-WORKER
VITE_PAYPAL_ENV=sandbox

# API Backend Gateway Target (used by Vite dev proxy if running Python backend)
VITE_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Python A2A Backend & Agent Network (FastAPI)
# ------------------------------------------------------------------------------
# Server host & port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Operating Mode: Set to 'true' to run fully offline without live external API keys
MOCK_EXTERNAL_APIS=true

# Seller Profile: 'ap2' (Autonomous Compute Node & Service Gateway Marketplace)
A2A_SELLER_PROFILE=ap2

# PayPal Developer REST Credentials (for server-side order/subscription verification)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Zapier Model Context Protocol / Natural Language Actions (Optional)
ZAPIER_NLA_API_KEY=

# Cryptographic Salt for Buyer Mandate HMAC-SHA256 Token Signing
A2A_MANDATE_SECRET=change-me

# Asymmetric Ed25519 Signing Keys (Legacy AP2 v0.1 Protocol)
A2A_SELLER_PRIVATE_KEY=
A2A_PRIVATE_KEY=
A2A_BUYER_PUBLIC_KEY=

# Google AP2 v0.2 Protocol Merchant Signing Key (ES256 / ECDSA P-256)
# Required in production to ensure persistent merchant identity and receipt verification
# across server restarts and worker processes. If unset, an ephemeral key is generated
# in-memory for testing / mock mode. NEVER commit private keys to version control.
# Example format: {"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","kid":"ap2-merchant-key-1"}
AP2_MERCHANT_PRIVATE_KEY_JWK=
AP2_MERCHANT_KEY_ID=ap2-merchant-key-1

# Admin API Key for administrative endpoints (mandate reset, ledger management)
ADMIN_API_KEY=change-me

# PayPal Recurring Billing Plan IDs (Sandbox overrides)
PAYPAL_PLAN_ID_BATCH=P-AP2-BATCH-WORKER
PAYPAL_PLAN_ID_GATEWAY=P-AP2-SERVICE-GATEWAY
PAYPAL_PLAN_ID_CLUSTER=P-AP2-CLUSTER-NODE
