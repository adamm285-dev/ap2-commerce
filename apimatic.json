{
  "apimaticVersion": "3.1.0",
  "project": {
    "name": "AP2 Autonomous Commerce SDK",
    "description": "Autonomous Agent-to-Agent Commerce Protocol for Compute Nodes and Service Gateways",
    "version": "1.0.0",
    "company": "AP2 Autonomous Marketplace",
    "copyright": "Copyright (c) 2026 AP2 Autonomous Marketplace. All rights reserved.",
    "license": "MIT",
    "repositoryUrl": "https://github.com/adamm285-dev/ap2-commerce"
  },
  "portal": {
    "title": "AP2 Autonomous Commerce Developer Portal",
    "brandColor": "#0284c7",
    "favicon": "https://api.ap2-commerce.org/favicon.png",
    "enableTryIt": true,
    "enableApiExploration": true
  },
  "codegen": {
    "python": {
      "packageName": "ap2_commerce_sdk",
      "clientClassName": "AP2CommerceClient",
      "pypiPackage": "ap2-commerce-sdk"
    },
    "typescript": {
      "packageName": "@ap2/commerce-sdk",
      "clientClassName": "AP2CommerceClient",
      "npmPackage": "@ap2/commerce-sdk"
    },
    "go": {
      "packageName": "ap2commerce",
      "modulePath": "github.com/adamm285-dev/ap2-commerce-go"
    }
  },
  "environments": {
    "production": "https://api.ap2-commerce.org",
    "sandbox": "http://localhost:8001"
  }
}
